<Window x:Class="InnManagerWPFDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManagerWPFDemo"
        xmlns:navigation="clr-namespace:InnManagerWPFDemo.Navigation"
        mc:Ignorable="d"
        Title="InnManger Hotel Management System" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="LightBlue">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold">InnManager</TextBlock>
                <TextBlock Grid.Column="1" FontSize="25" FontWeight="Bold">Hotel Management System</TextBlock>

            </Grid>
             </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="600"/>
                
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="LightPink">
                <StackPanel>
                    <Button Content="Home" Height=" 50" Margin="5" FontWeight="Bold" FontSize="20" Click="Button_Click"/>
                    <Button Content="Rooms" Height=" 50" Margin="5" FontWeight="Bold" FontSize="20" Click="Button_Click_1"/>
                    <Button Content="Reservation" Height=" 50" Margin="5" FontWeight="Bold" FontSize="20"/>
                    <Button Content="Guests" Height=" 50" Margin="5" FontWeight="Bold" FontSize="20"/>
                    <Button Content="Services" Height=" 50" Margin="5" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
                
            </Border>
            <Grid Grid.Column="1" Name="ContentArea">
                

            </Grid>
            </Grid>


    </Grid>
</Window>
