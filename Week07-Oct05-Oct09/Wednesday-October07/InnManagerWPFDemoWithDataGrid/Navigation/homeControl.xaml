<UserControl x:Class="InnManagerWPFDemo.Navigation.homeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManagerWPFDemo.Navigation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>

            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="LightCoral">
            <TextBlock Name="Welcome"  FontSize="30" FontWeight="Bold" HorizontalAlignment="Center">Welcome to InnManager Application</TextBlock>
        </Border>
        <Border Grid.Row="1" Background="LightGreen"></Border>
        <Border Grid.Row="2" Background="LightCyan"></Border>

    </Grid>
</UserControl>
